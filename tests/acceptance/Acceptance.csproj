<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UmbracoVersion Condition="'$(UmbracoVersion)' == ''">18.1.1</UmbracoVersion>
    <RazorSearchVersion Condition="'$(RazorSearchVersion)' == ''">18.0.0-beta.1</RazorSearchVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="$(UmbracoVersion)" />
    <PackageReference Include="Umbraco.Community.RazorSearch.Examine" Version="$(RazorSearchVersion)" />
  </ItemGroup>
</Project>

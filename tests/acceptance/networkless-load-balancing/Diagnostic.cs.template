using System.Net.Http.Json;
using System.Text.Json;
using Microsoft.AspNetCore.TestHost;
using Umbraco.Cms.Core.Routing;
using Umbraco.Cms.Core.Services;

static class Diagnostic
{
    public static async Task RunAsync(WebApplication app)
    {
        using var deadline = new CancellationTokenSource(TimeSpan.FromMinutes(14));
        var token = deadline.Token;
        string directory = app.Configuration["Acceptance:CoordinationDirectory"]!;
        bool publisher = app.Configuration["Acceptance:Role"] == "SchedulingPublisher";
        string node = publisher ? "BO" : "FE";
        try
        {
            await app.StartAsync(token);
            using var client = app.GetTestClient();
            client.Timeout = TimeSpan.FromSeconds(30);
            async Task Wait(Func<Task<bool>> predicate, string description)
            {
                var until = DateTime.UtcNow.AddSeconds(150); int consecutive = 0;
                while (DateTime.UtcNow < until)
                {
                    if (app.Services.GetRequiredService<IRuntimeState>().BootFailedException is { } failed)
                        throw new Exception("CMS boot failed", failed);
                    if (await predicate()) consecutive++; else consecutive=0; if (consecutive >= 3) { Console.WriteLine($"LB {node} PASS {description}"); return; }
                    await Task.Delay(500, token);
                }
                throw new Exception("Timed out: " + description);
            }
            await Wait(() => Task.FromResult(app.Services.GetRequiredService<IContentRoutingReadiness>().IsReady), "startup readiness after all migration handlers");
            async Task<JsonElement> Get(string path) => await client.GetFromJsonAsync<JsonElement>(path, token);
            async Task<JsonElement> Post(string path)
            {
                using var response = await client.PostAsync(path, null, token);
                string body = await response.Content.ReadAsStringAsync(token);
                if (!response.IsSuccessStatusCode) throw new Exception($"{path}: {response.StatusCode} {body}");
                return JsonDocument.Parse(body).RootElement.Clone();
            }
            var retained = new Dictionary<string, JsonElement>(); async Task<JsonElement> Search(string query, string? culture = null) { var result=await Get("/acceptance/search?q=" + Uri.EscapeDataString(query) + (culture is null ? "" : "&culture=" + culture)); retained[query+"|"+culture]=result; return result; }
            async Task<bool> Count(string query, string? culture, int count) { var result=await Search(query,culture); return result.GetProperty("total").GetInt32()==count && result.GetProperty("items").GetArrayLength()==count; }
            async Task Matrix(int invariant, int danish, int english)
            {
                await Wait(async () => await Count("commonword", null, invariant) && await Count("commonword", "da-DK", danish) && await Count("commonword", "en-US", english), $"culture totals {invariant}/{danish}/{english}");
                foreach (string? culture in new string?[] { null, "da-DK", "en-US" })
                {
                    var result = retained["commonword|"+culture];
                    foreach (var item in result.GetProperty("items").EnumerateArray())
                    {
                        string? url = item.GetProperty("url").GetString();
                        if (!Uri.TryCreate(url, UriKind.Absolute, out var absolute) || absolute.Host != "localhost" || absolute.Fragment.Length != 0)
                            throw new Exception("Invalid public URL: " + url);
                    }
                    Console.WriteLine($"LB {node} RESULT {culture ?? "invariant"} {result}");
                }
            }
            async Task Mark(string phase) => await File.WriteAllTextAsync(Path.Combine(directory, phase + ".ready"), "ready", token);
            async Task WaitMarker(string phase) => await Wait(() => Task.FromResult(File.Exists(Path.Combine(directory, phase + ".ready"))), "phase " + phase);
            if (publisher)
            {
                var seed = await Post("/acceptance/seed");
                var invariant = seed.GetProperty("invariantKey").GetGuid();
                var variant = seed.GetProperty("variantKey").GetGuid();
                if (!seed.GetProperty("invariantPublished").GetBoolean() || !seed.GetProperty("variantPublished").GetBoolean()) throw new Exception("Seed publish failed");
                await Post($"/acceptance/domains/{variant}");
                var childResponse = await Post($"/acceptance/child/{invariant}");
                var child = childResponse.GetProperty("key").GetGuid();
                if (!childResponse.GetProperty("published").GetBoolean()) throw new Exception("Child publish failed");
                await Post("/acceptance/rebuild");
                await Matrix(2, 3, 3);
                await File.WriteAllTextAsync(Path.Combine(directory, "keys.json"), JsonSerializer.Serialize(new { invariant, variant, child }), token);
                await Mark("initial");
                await WaitMarker("initial-fe");
                await Post($"/acceptance/mutate/{child}?action=draft&name=draftonlytoken");
                await Matrix(2, 3, 3);
                if (!await Count("draftonlytoken", null, 0)) throw new Exception("Draft text leaked");
                await Mark("draft"); await WaitMarker("draft-fe");
                await Post($"/acceptance/mutate/{child}?action=publish&name=renamedtoken");
                await Matrix(1, 2, 2);
                await Wait(async () => await Count("renamedtoken", null, 1), "renamed published text");
                await Wait(async () => {var renamed = await Search("renamedtoken"); return renamed.GetProperty("total").GetInt32()==1 && renamed.GetProperty("items").GetArrayLength()==1 && renamed.GetProperty("items")[0].GetProperty("url").GetString()!.EndsWith("/renamedtoken/");}, "current public URL in same response");
                await Mark("rename"); await WaitMarker("rename-fe");
                await Post($"/acceptance/mutate/{variant}?action=unpublish-culture&culture=da-DK");
                await Matrix(1, 1, 2);
                await Mark("partial"); await WaitMarker("partial-fe");
                await Post($"/acceptance/mutate/{child}?action=unpublish");
                await Wait(async () => await Count("renamedtoken", null, 0), "unpublished child removed");
                await Mark("unpublish"); await WaitMarker("unpublish-fe");
                Console.WriteLine("LB BO PASS all distributed lifecycle phases");
            }
            else
            {
                await WaitMarker("initial");
                await Matrix(2, 3, 3);
                if (!await Count("englishonly", "da-DK", 0) || !await Count("danishonly", "en-US", 0) || !await Count("englishonly", null, 0)) throw new Exception("Cross-culture result leaked");
                Console.WriteLine("LB FE PASS fresh separate index bootstrap and exact culture isolation");
                await Mark("initial-fe");
                await WaitMarker("draft"); await Matrix(2, 3, 3);
                if (!await Count("draftonlytoken", null, 0)) throw new Exception("Draft text leaked");
                await Mark("draft-fe");
                await WaitMarker("rename"); await Matrix(1, 2, 2);
                await Wait(async () => await Count("renamedtoken", null, 1), "distributed renamed text");
                await Wait(async () => {var renamed = await Search("renamedtoken","da-DK"); return renamed.GetProperty("total").GetInt32()==1 && renamed.GetProperty("items").GetArrayLength()==1 && renamed.GetProperty("items")[0].GetProperty("url").GetString()!.EndsWith("/renamedtoken/");}, "current invariant URL in cultured response"); Console.WriteLine("LB FE RESULT renamed " + retained["renamedtoken|da-DK"]);
                await Mark("rename-fe");
                await WaitMarker("partial"); await Matrix(1, 1, 2);
                await Wait(async () => await Count("danishonly", "da-DK", 0) && await Count("englishonly", "en-US", 1), "partial unpublish exact language convergence");
                await Mark("partial-fe");
                await WaitMarker("unpublish");
                await Wait(async () => await Count("renamedtoken", null, 0), "distributed full unpublish");
                await Mark("unpublish-fe");
                await Matrix(1,1,2); await Task.Delay(10000,token); for(int sample=0;sample<10;sample++) { if(!await Count("commonword",null,1) || !await Count("commonword","da-DK",1) || !await Count("commonword","en-US",2)) {Console.WriteLine("QUIET INDEX "+await Get("/acceptance/index"));Console.WriteLine("QUIET STATUS "+await Get("/acceptance/status"));Console.WriteLine("QUIET INSPECT "+await Get("/acceptance/inspect")); throw new Exception("Quiescent query inconsistency");} await Task.Delay(1000,token); } Console.WriteLine("LB FE PASS ten quiescent query matrices"); Console.WriteLine("LB FE PASS all distributed lifecycle phases");
            }
        }
        finally
        {
            await app.StopAsync(TimeSpan.FromSeconds(10));
            await app.DisposeAsync();
        }
    }
}

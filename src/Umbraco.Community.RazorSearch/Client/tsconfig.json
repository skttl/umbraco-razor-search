{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "experimentalDecorators": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "isolatedModules": true,
    "useDefineForClassFields": true
  },
  "include": [
    "vite.config.ts",
    "src/**/*.ts"
  ]
}
